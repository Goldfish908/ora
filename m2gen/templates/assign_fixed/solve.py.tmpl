import json
from pathlib import Path

from pyscipopt import Model


def main():
    here = Path(__file__).resolve()
    data_path = next(p / "data" / "params.json"
                     for p in (here.parents[1], here.parents[2])
                     if (p / "data" / "params.json").exists())
    d = json.loads(data_path.read_text())
    W, J = d["workers"], d["jobs"]
    m = Model()
    m.hideOutput()
    x = {(w, j): m.addVar(f"x_{w}_{j}", vtype="B") for w in W for j in J}
    y = {w: m.addVar(f"y_{w}", vtype="B") for w in W}
    for j in J:
        m.addCons(sum(x[w, j] for w in W) == 1)
    for w in W:
        m.addCons(sum(x[w, j] for j in J) <= d["cap"][w])
    for w in W:
        for j in J:
            ${LINK_CON}
    m.setObjective(
        sum(${COST_EXPR} for w in W for j in J)
        + sum(d["fixed"][w] * y[w] for w in W))
    m.optimize()
    sol = {
        "objective": round(m.getObjVal(), 6),
        "assign": {w: {j: round(m.getVal(x[w, j]), 6) for j in J} for w in W},
        "active": {w: round(m.getVal(y[w]), 6) for w in W},
    }
    out = Path(__file__).resolve().parent / "solution.json"
    out.write_text(json.dumps(sol, indent=2))
    print(f"OBJECTIVE {sol['objective']}")


